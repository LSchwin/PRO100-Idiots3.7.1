; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CallingCard"
run/main_scene="uid://cjjanmmuxihyw"
config/use_custom_user_dir=true
config/custom_user_dir_name="Idiots3/Cardistry"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="uid://dmmnmywm1vyrb"

[audio]

buses/default_bus_layout="uid://b8tmxk2eabuek"

[autoload]

Persistent="*uid://jkp3jkwkfknn"
PersistentCS="*uid://g0c6kdfycvr2"
Delays="*uid://tqlbaksajrhu"
DelaysCS="*uid://dioqk6ay4vbbq"
Music="*uid://b24lljs7tywiw"
MusicCS="*uid://boskg40oa36f6"
Selector="*uid://5ck2mjhpt07c"
SelectorCS="*uid://cjq6vt786kpv7"
Scenes="*uid://juuxa6m3s2jx"
ScenesCs="*uid://bg6s7l6u1ktjp"
GameCS="*uid://dcjp8kkqj4hat"

[display]

window/size/viewport_width=768
window/size/viewport_height=432
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="CallingCard"

[file_customization]

folder_colors={
"res://Assets/": "gray",
"res://Game/": "purple",
"res://Game/Cards/": "red",
"res://UI/": "yellow",
"res://_Globals/": "gray"
}

[gui]

common/auto_focus_strategy=1
theme/custom_font="uid://ccqu2tt64ere"

