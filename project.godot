; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CallingCard"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://b8tmxk2eabuek"

[autoload]

Delays="*uid://tqlbaksajrhu"
DelaysCS="*uid://dioqk6ay4vbbq"
Music="*uid://b24lljs7tywiw"
MusicCS="*uid://boskg40oa36f6"
Selector="*uid://5ck2mjhpt07c"
SelectorCS="*uid://cjq6vt786kpv7"

[display]

window/size/viewport_width=896
window/size/viewport_height=504
window/stretch/mode="viewport"

[dotnet]

project/assembly_name="CallingCard"

[file_customization]

folder_colors={
"res://Assets/": "gray",
"res://Game/": "purple",
"res://UI/": "yellow",
"res://_Globals/": "gray"
}

[gui]

common/auto_focus_strategy=1

